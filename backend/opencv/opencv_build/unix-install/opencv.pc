# Package Information for pkg-config

prefix=/usr/local
exec_prefix=${prefix}
libdir=${exec_prefix}/lib
includedir=${prefix}/include/opencv5

Name: OpenCV
Description: Open Source Computer Vision Library
Version: 5.1.0
Libs: -L${exec_prefix}/lib -lopencv_stitching -lopencv_alphamat -lopencv_bgsegm -lopencv_bioinspired -lopencv_ccalib -lopencv_cudabgsegm -lopencv_cudaobjdetect -lopencv_cudastereo -lopencv_dnn_objdetect -lopencv_dnn_superres -lopencv_dpm -lopencv_face -lopencv_freetype -lopencv_fuzzy -lopencv_gapi -lopencv_hdf -lopencv_hfs -lopencv_img_hash -lopencv_intensity_transform -lopencv_line_descriptor -lopencv_quality -lopencv_rapid -lopencv_reg -lopencv_rgbd -lopencv_ptcloud -lopencv_saliency -lopencv_sfm -lopencv_signal -lopencv_structured_light -lopencv_phase_unwrapping -lopencv_superres -lopencv_cudacodec -lopencv_surface_matching -lopencv_videostab -lopencv_cudaoptflow -lopencv_optflow -lopencv_cudalegacy -lopencv_cudafeatures2d -lopencv_calib -lopencv_cudawarping -lopencv_wechat_qrcode -lopencv_objdetect -lopencv_xfeatures2d -lopencv_shape -lopencv_ximgproc -lopencv_xobjdetect -lopencv_xphoto -lopencv_photo -lopencv_cudaimgproc -lopencv_cudafilters -lopencv_cudaarithm -lopencv_xstereo -lopencv_tracking -lopencv_highgui -lopencv_datasets -lopencv_videoio -lopencv_video -lopencv_text -lopencv_imgcodecs -lopencv_features -lopencv_dnn -lopencv_stereo -lopencv_plot -lopencv_ml -lopencv_imgproc -lopencv_geometry -lopencv_flann -lopencv_core -lopencv_cudev
Libs.private: -lm -lpthread -lcudart_static -ldl -lrt -lnppc -lnppial -lnppicc -lnppidei -lnppif -lnppig -lnppim -lnppist -lnppisu -lnppitc -lnpps -lcublas -lcudnn -lcufft -L-L/usr/local/cuda-13.2 -llib64 -L-L/usr/lib -laarch64-linux-gnu
Cflags: -I${includedir}
